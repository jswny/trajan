{
	"name": "trajan-workspace",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "vp run @trajan/app#dev",
		"check": "vp run -r types && vp check && vp run -r test",
		"ready": "vp run check && vp run -r build"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	},
	"packageManager": "npm@12.0.1",
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
