{
	"name": "trajan",
	"version": "0.1.0",
	"private": true,
	"description": "A durable Pi agent on Cloudflare Workers",
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"start": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy --force",
		"types": "cf workers types",
		"typecheck": "cf workers types && vp check --no-fmt --no-lint",
		"format": "vp fmt",
		"test": "vp test run --config src/tests/vitest.config.ts",
		"check": "cf workers types && vp check && npm test",
		"smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@cloudflare/computer": "^0.10.0",
		"@cloudflare/kumo": "^2.6.0",
		"@earendil-works/chord": "~1.6.0",
		"@earendil-works/pi-ai": "~1.6.0",
		"@earendil-works/pi-durable": "~1.6.0",
		"@earendil-works/pi-schema": "~1.6.0",
		"@earendil-works/pi-telemetry": "~1.6.0",
		"@effect/atom-react": "4.1.5",
		"@phosphor-icons/react": "^2.1.10",
		"@pierre/highlights": "0.5.2",
		"@pierre/words": "0.3.0",
		"@platformatic/vfs": "^0.4.0",
		"agents": "^0.34.0",
		"effect": "4.1.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typebox": "1.3.27",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-rc.1",
		"@cloudflare/vitest-plugin": "^1.8.3",
		"@cloudflare/workers-types": "^5.20261014.1",
		"@tailwindcss/vite": "^4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"cf": "1.0.0-rc.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
