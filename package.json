{
  "name": "trajan",
  "description": "A durable Pi agent on Cloudflare Workers",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "cf dev",
    "start": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy --prebuilt",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run --config src/tests/vitest.config.ts",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.10.0",
    "@cloudflare/kumo": "^2.6.0",
    "@earendil-works/chord": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-durable": "~1.5.0",
    "@earendil-works/pi-schema": "~1.5.0",
    "@earendil-works/pi-telemetry": "~1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.4.0",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.33.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "^2.5.0",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "4.1.12",
    "cf": "1.0.0-rc.0",
    "@cloudflare/vitest-plugin": "^1.8.3"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
