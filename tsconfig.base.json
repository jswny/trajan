{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
